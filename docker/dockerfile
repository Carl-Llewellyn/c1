# Use the official Ubuntu 22.04 LTS base image
FROM ubuntu:22.04

# Set the architecture to 32-bit (i386)
RUN dpkg --add-architecture i386

# Update package list and install necessary dependencies
RUN apt-get update && \
    apt-get install -y \
    build-essential \
    libstdc++6 \
    libgl1-mesa-dev \
    libsdl2-dev \
    libfluidsynth-dev \
    && apt-get clean

# Set the working directory (optional, modify as needed)
WORKDIR /workspace

# Set the default command (optional, modify as needed)
CMD ["bash"]
